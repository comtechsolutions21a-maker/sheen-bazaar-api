# =========================================================
# Sheen Bazaar — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to version control.
# =========================================================

PORT=5000

# MongoDB Atlas connection string (get one free at mongodb.com/atlas)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bazaario?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bazaario

# Long random string used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# Your Netlify frontend URL (update after Step 2 of deployment)
# Example: https://sheen-bazaar.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# =========================================================
# Optional: Real email notifications to sellers
# If left blank, notifications are printed to the server console only.
# =========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sheen Bazaar <notifications@sheenbazaar.com>

# =========================================================
# Social login — Google, Facebook, X (Twitter)
# Leave any of these blank and that provider's button will show
# a clear "not configured" error instead of crashing the server.
# =========================================================

# Google — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Add your frontend URL (e.g. https://sheenbazaar.online) to
# "Authorized JavaScript origins" — no redirect URI is needed for this flow.
GOOGLE_CLIENT_ID=

# Facebook — create an app at https://developers.facebook.com/apps,
# add the "Facebook Login" product, and add your frontend domain under
# Settings > Basic > App Domains.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X (Twitter) — create a project/app at https://developer.twitter.com,
# enable "OAuth 2.0" with type "Web App", and set the callback URL below
# to EXACTLY match what you register there (this backend's own URL + this path).
# Example: https://sheen-bazaar-api.onrender.com/api/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:5000/api/auth/twitter/callback
